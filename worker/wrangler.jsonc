{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clearconnect-selectors",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // Stores the LinkedIn selector schema and the report rate-limit counters.
  // This id is a resource handle, not a credential -- the API token is the secret
  // and lives in GitHub Secrets. CI needs a real id here to deploy.
  // Point it at your own namespace: npx wrangler kv namespace create SELECTORS_KV
  "kv_namespaces": [
    { "binding": "SELECTORS_KV", "id": "e0d3fff154494194b56689ed4363f3af" }
  ],

  // Cloudflare Email Service binding used to deliver alert emails.
  // Requires a domain onboarded to Email Sending on this account.
  "send_email": [
    { "name": "EMAIL" }
  ],

  // Non-secret configuration only.
  //
  // ADMIN_SECRET, ALERT_TO and ALERT_FROM are all set as secrets, not vars, so
  // that no email address or credential is ever committed to this repository:
  //   npx wrangler secret put ADMIN_SECRET
  //   npx wrangler secret put ALERT_TO
  //   npx wrangler secret put ALERT_FROM
  "vars": {
    // Comma-separated CORS allow-list, e.g. "chrome-extension://<extension-id>".
    // Leave empty to allow any origin.
    "ALLOWED_ORIGINS": ""
  }
}
